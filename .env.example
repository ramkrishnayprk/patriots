SCRAPERAPI_KEY=

FLASK_ENV=production
REDIS_URL=redis://redis:6379/0
DATA_DIR=/app/data

BASE_URL=https://degrees.ucumberlands.edu/
ALLOWED_DOMAIN=degrees.ucumberlands.edu
MAX_PAGES=300
MIN_DELAY_SECONDS=0.75
MAX_DELAY_SECONDS=1.75
REQUEST_TIMEOUT_SECONDS=90
RENDER_JAVASCRIPT=false
CHECKPOINT_INTERVAL=10
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK=150
CHUNK_STRATEGY=section_aware
EMBED_PREFIX=true

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_PATH=/models
EMBEDDING_DIMENSION=384
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=auto
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
EMBEDDING_PASSAGE_PREFIX=
