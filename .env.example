TMDB_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=600
GENERATION_MIN_RERANK_SCORE=-4.5

FLASK_ENV=production
REDIS_URL=redis://redis:6379/0
DATA_DIR=/app/data

MOVIE_WINDOW_START=2026-01-01
MOVIE_TITLE_TYPES=movie
MOVIE_INCLUDE_ADULT=false
MOVIE_REGION_PREFERENCE=US
MOVIE_TOP_CAST_LIMIT=10
MOVIE_MAX_CANDIDATES=2500
ENABLE_WIKIPEDIA=false
IMDB_DATASET_BASE_URL=https://datasets.imdbws.com
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT=37
TMDB_RATE_WINDOW_SECONDS=10
TMDB_TRANSIENT_CACHE_HOURS=24
REQUEST_TIMEOUT_SECONDS=90
DOWNLOAD_CHUNK_BYTES=1048576
USER_AGENT=Movie-RAG-Research-Pipeline/1.0 (private educational project)

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK=150
CHUNK_STRATEGY=section_aware
EMBED_PREFIX=true

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_PATH=/models
EMBEDDING_DIMENSION=384
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=auto
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
EMBEDDING_PASSAGE_PREFIX=
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2

RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_TOP_N=30
RETRIEVAL_FINAL_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.01
RETRIEVAL_MAX_PER_DOCUMENT=2
RETRIEVAL_MAX_QUERY_CHARS=1000
RETRIEVAL_ENABLE_FILTERS=true
STRUCTURED_BACKEND=jsonl
STRUCTURED_RECORDS_FILENAME=movies_2026.jsonl
STRUCTURED_MAX_LIST_ITEMS=50
